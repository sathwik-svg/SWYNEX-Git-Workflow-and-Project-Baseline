# Dependencies & Local Builds
node_modules
dist
dist-ssr
build
.output

# Git & Version Control
.git
.github
.gitignore

# Environment & Secrets
.env
.env*.local
.env.production
.env.development
!.env.example

# Test Coverage & Logs
coverage
*.lcov
.nyc_output
*.log
npm-debug.log*
yarn-debug.log*

# IDE & OS Caches
.vscode
.idea
.DS_Store
Thumbs.db
.cache
.vite
